{
    "name": "elearning-core-frontend",
    "version": "2.0.4",
    "license": "MIT",
    "scripts": {
        "build:demo": "ng build --configuration=demo",
        "build:local": "ng build --configuration=local",
        "build:staging": "ng build --aot --build-optimizer --configuration=staging",
        "build:production": "ng build --aot --build-optimizer --configuration=production",
        "serve": "ng serve --port=4200 --configuration=local",
        "test": "ng test",
        "test:headless": "ng test --watch=false --browsers=ChromeHeadless",
        "test:nomap": "ng test --source-map=false",
        "lint": "eslint ./src --ext .ts,.html",
        "lint:fix": "eslint ./src --ext .ts,.html --fix",
        "format": "prettier --write \"./src/**/*.{ts,html,scss,json}\"",
        "e2e": "ng e2e",
        "cypress:open": "cypress open",
        "cypress:run": "cypress run"
    },
    "private": true,
